# Copy to voice/.env and fill in. Never commit the real file.
# The cloud voice only ever receives sentences without data.
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=your-voice-id
# Optional (defaults shown)
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=pcm_24000
ELEVENLABS_LANGUAGE=es

# Verification call (#23): ElevenLabs Conversational AI outbound call over Twilio.
# If any is missing, voice/call.py runs in dry-run (simulated transcript).
ELEVENLABS_AGENT_ID=your-agent-id
ELEVENLABS_PHONE_NUMBER_ID=your-twilio-phone-number-id
