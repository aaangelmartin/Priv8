{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://priv8.dev/contracts/voice.schema.json",
  "title": "Frase de voz mixta",
  "description": "Una frase partida en segmentos. cloud va a ElevenLabs tras el bloqueo final. local lo lee la voz del móvil (TextToSpeech) o del portátil (Web Speech) después de que el renderizador local sustituya el token. Si un segmento cloud contiene un patrón sensible, no sale: la frase entera se lee con la voz local y queda en la auditoría.",
  "type": "object",
  "required": ["utterance", "session", "segments"],
  "additionalProperties": false,
  "properties": {
    "utterance": { "type": "string", "pattern": "^u[0-9]+$" },
    "session": { "$ref": "common.schema.json#/$defs/session" },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/segment" }
    }
  },
  "$defs": {
    "segment": {
      "oneOf": [
        {
          "description": "Texto sin datos, para ElevenLabs.",
          "type": "object",
          "required": ["voice", "text"],
          "additionalProperties": false,
          "properties": {
            "voice": { "const": "cloud" },
            "text": { "type": "string", "minLength": 1 }
          }
        },
        {
          "description": "Un token que se rehidrata y se lee en local.",
          "type": "object",
          "required": ["voice", "token"],
          "additionalProperties": false,
          "properties": {
            "voice": { "const": "local" },
            "token": { "$ref": "common.schema.json#/$defs/token" },
            "say_as": { "enum": ["currency", "number", "digits", "name", "date", "phone", "iban", "text"] }
          }
        },
        {
          "description": "Texto que se lee en local tal cual (frase degradada tras un bloqueo).",
          "type": "object",
          "required": ["voice", "text"],
          "additionalProperties": false,
          "properties": {
            "voice": { "const": "local" },
            "text": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
