# Copy to .env and fill in. Never commit .env. Use it with: uv run --env-file .env ...
# make replay needs none of this.

# Claude API key for the live agent (make agent).
ANTHROPIC_API_KEY=
# In-process core for the MCP server and the agent: real (core/) or fake (in-memory).
PRIV8_CORE=real

# Signed audit log and its ed25519 key (created if missing). PRIV8_AUDIT=off keeps it in memory.
PRIV8_AUDIT=audit/priv8.jsonl
PRIV8_AUDIT_KEY=audit/priv8.key

# Cloud voice (see voice/README.md).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
