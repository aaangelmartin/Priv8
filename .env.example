# Copy to .env and fill in. Never commit .env. Use it with: uv run --env-file .env ...
# make replay needs none of this.

# Claude API key for the live agent (make agent).
ANTHROPIC_API_KEY=
# In-process core for the MCP server and the agent: real (core/) or fake (in-memory).
PRIV8_CORE=real

# Signed audit log and its ed25519 key (created if missing). PRIV8_AUDIT=off keeps it in memory.
PRIV8_AUDIT=audit/priv8.jsonl
PRIV8_AUDIT_KEY=audit/priv8.key

# Cloud voice (see voice/README.md).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Bank call (#24, see voice/README.md). Without any of this, make llamada-banco uses the
# simulated Banca Alcor line in process. PRIV8_IVR_URL=http://127.0.0.1:8711 calls `make linea-alcor`.
PRIV8_IVR_URL=
# claude: Claude picks the menu key from tokenized text. Needs ANTHROPIC_API_KEY.
PRIV8_LLAMADA_NAVEGADOR=
# Real call, UNTESTED: PRIV8_LLAMADA_REAL=1 plus ELEVENLABS_API_KEY, ELEVENLABS_AGENT_ID,
# ELEVENLABS_PHONE_NUMBER_ID (also used by the verification call of #23) and PRIV8_BANCO_TEL.
PRIV8_LLAMADA_REAL=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
PRIV8_BANCO_TEL=

# Límites de gasto del agente, en dólares (la demo usa estos). El tope total se pone en la
# Console de Anthropic como límite de gasto del workspace de la clave.
PRIV8_TASK_BUDGET_USD=0.05
PRIV8_SESSION_BUDGET_USD=0.50

# Modelo del agente. La demo usa Haiku: rápido y barato. Sin esta línea, claude-opus-5-5.
PRIV8_MODEL=claude-haiku-5-5
# PRIV8_EFFORT=low
