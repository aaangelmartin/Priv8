<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Bank" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/bank_primary</item>
        <item name="colorPrimaryDark">@color/bank_primary_dark</item>
        <item name="colorAccent">@color/bank_accent</item>
        <item name="android:windowBackground">@color/bank_background</item>
        <item name="android:statusBarColor">@color/bank_primary_dark</item>
        <item name="android:textColorPrimary">@color/bank_text</item>
        <item name="android:textColorSecondary">@color/bank_text_secondary</item>
    </style>

    <!-- Raíz de los estilos Bank.* -->
    <style name="Bank" />

    <style name="Bank.Screen">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:fillViewport">true</item>
    </style>

    <style name="Bank.Content">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">20dp</item>
    </style>

    <style name="Bank.Header">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@color/bank_primary</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <style name="Bank.HeaderTitle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/bank_on_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:accessibilityHeading">true</item>
    </style>

    <style name="Bank.HeaderButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:textColor">@color/bank_on_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Bank.Title">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/bank_text</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:accessibilityHeading">true</item>
    </style>

    <style name="Bank.Section">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/bank_text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:accessibilityHeading">true</item>
    </style>

    <style name="Bank.Label">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/bank_text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>

    <style name="Bank.Value">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/bank_text</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="Bank.Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">@color/bank_text</item>
        <item name="android:textColorHint">@color/bank_text_secondary</item>
        <item name="android:textSize">17sp</item>
        <item name="android:importantForAutofill">no</item>
    </style>

    <style name="Bank.Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>

    <style name="Bank.Button" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">@color/bank_on_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">17sp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Bank.Button.Secondary">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/bank_primary</item>
    </style>

    <style name="Bank.Error">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/bank_error</item>
        <item name="android:textSize">15sp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:visibility">gone</item>
        <item name="android:accessibilityLiveRegion">polite</item>
    </style>
</resources>
