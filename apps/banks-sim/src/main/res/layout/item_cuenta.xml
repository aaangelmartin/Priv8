<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de cuenta en el inicio. Se repite una vez por cuenta, con los mismos resource-ids. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cuenta"
    style="@style/Bank.Card"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cuenta_alias"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/bank_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cuenta_saldo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/bank_text"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/cuenta_iban"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="monospace"
        android:textColor="@color/bank_text_secondary"
        android:textSize="14sp" />
</LinearLayout>
