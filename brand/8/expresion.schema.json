{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://priv8.local/brand/8/expresion.schema.json",
  "title": "Expresión de 8",
  "description": "Una cara de 8 hecha solo con sus ojos: una postura y hasta cuatro movimientos. El motor recorta cualquier valor fuera de rango e ignora claves desconocidas, así que no se pueden añadir dibujos, colores ni texto. Usa una expresión a medida solo cuando ninguno de los estados del juego cerrado (P8.estados) encaje.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "nombre"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{1,40}$",
      "description": "Identificador corto, en minúsculas."
    },
    "nombre": {
      "type": "string",
      "maxLength": 40,
      "description": "Nombre legible, en español."
    },
    "descripcion": {
      "type": "string",
      "maxLength": 140,
      "description": "Cuándo la usa 8, en una frase."
    },
    "extiende": {
      "type": "string",
      "description": "Id de otra expresión a medida de la que parte; las claves dadas la sobrescriben."
    },
    "mirada": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number",
          "minimum": -1,
          "maximum": 1,
          "description": "-1 izquierda, 1 derecha."
        },
        "y": {
          "type": "number",
          "minimum": -1,
          "maximum": 1,
          "description": "-1 arriba, 1 abajo."
        },
        "sigue": {
          "type": "boolean",
          "description": "Si es true, sigue al puntero y x/y solo se usan sin puntero."
        }
      }
    },
    "parpados": {
      "$ref": "#/$defs/par",
      "description": "Párpado superior: 0 abierto, 0.9 casi cerrado. Número para los dos ojos u objeto {izq, der}.",
      "x-rango": [
        0,
        0.9
      ]
    },
    "ceno": {
      "$ref": "#/$defs/par",
      "description": "Inclinación del párpado en grados: positivo baja la esquina interior (enfado, firmeza), negativo la exterior (tristeza, súplica).",
      "x-rango": [
        -20,
        20
      ]
    },
    "sonrisa": {
      "$ref": "#/$defs/par",
      "description": "Párpado inferior que sube: 0 nada, 0.6 ojos muy sonrientes.",
      "x-rango": [
        0,
        0.6
      ]
    },
    "pupilas": {
      "$ref": "#/$defs/par",
      "description": "Tamaño de pupila: 0.5 diminuta (miedo, sorpresa), 1 normal, 1.3 grande (ternura, súplica).",
      "x-rango": [
        0.5,
        1.3
      ]
    },
    "inclinacion": {
      "type": "number",
      "minimum": -15,
      "maximum": 15,
      "description": "Inclinación de la cabeza en grados."
    },
    "acercamiento": {
      "type": "number",
      "minimum": 0.9,
      "maximum": 1.08,
      "description": "Escala: <1 se echa atrás, >1 se acerca."
    },
    "desplazamiento": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number",
          "minimum": -3,
          "maximum": 3
        },
        "y": {
          "type": "number",
          "minimum": -3,
          "maximum": 3,
          "description": "Negativo sube, positivo se hunde."
        }
      }
    },
    "parpadeo": {
      "enum": [
        "normal",
        "lento",
        "nunca"
      ],
      "description": "Cómo parpadea mientras dura la expresión."
    },
    "movimientos": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tipo"
        ],
        "properties": {
          "tipo": {
            "enum": [
              "balanceo",
              "vaiven",
              "saltitos",
              "sacudir",
              "asentir",
              "latido",
              "temblor",
              "mirar_alrededor",
              "barrido",
              "respirar"
            ]
          },
          "amplitud": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0.5
          },
          "ritmo": {
            "type": "number",
            "minimum": 0.2,
            "maximum": 3,
            "default": 1,
            "description": "Hercios."
          }
        }
      }
    },
    "duracion": {
      "type": "number",
      "minimum": 0.3,
      "maximum": 10,
      "description": "Segundos. Si se da, la expresión es de una vez y después pasa a 'despues'."
    },
    "despues": {
      "type": "string",
      "description": "Estado del juego cerrado al que vuelve tras 'duracion'. Por defecto, mirar (reposo)."
    }
  },
  "$defs": {
    "par": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "izq": {
              "type": "number"
            },
            "der": {
              "type": "number"
            }
          }
        }
      ]
    }
  }
}
